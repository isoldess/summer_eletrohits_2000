
@startuml
title Diagrama de Classes - Portal de Vagas

skinparam classAttributeIconSize 0
hide empty members

enum Perfil {
    ESTUDANTE
    EMPRESA
    ADMINISTRADOR
}

enum Modalidade {
    PRESENCIAL
    REMOTA
    HIBRIDA
}

enum SituacaoVaga {
    ABERTA
    ENCERRADA
}

class Usuario {
    - id: int
    - nome: String
    - email: String
    - perfil: Perfil
    - curso: String
    - nomeEmpresa: String
    --
    + publicarVaga(vaga: Vaga): void
    + editarVaga(vaga: Vaga): void
    + encerrarVaga(vaga: Vaga): void
    + candidatar(vaga: Vaga): Candidatura
    + consultarMinhasCandidaturas(): List<Candidatura>
    + consultarCandidatos(vaga: Vaga): List<Candidatura>
    + consultarIndicadores(): void
}

class Area {
    - id: int
    - nome: String
    --
    + cadastrar(): void
    + editar(): void
    + excluir(): void
}

class Vaga {
    - id: int
    - titulo: String
    - descricao: String
    - localizacao: String
    - modalidade: Modalidade
    - cargaHorariaSemanal: int
    - situacao: SituacaoVaga
    --
    + publicar(): void
    + editar(): void
    + encerrar(): void
    + consultarVagasAbertas(): List<Vaga>
    + filtrarPorArea(area: Area): List<Vaga>
    + filtrarPorModalidade(modalidade: Modalidade): List<Vaga>
}

class Candidatura {
    - id: int
    - dataInscricao: Date
    --
    + registrar(): void
    + validarDuplicidade(): boolean
}

class PortalVagas {
    + validarPerfil(usuario: Usuario, perfil: Perfil): boolean
    + verificarPropriedadeVaga(empresa: Usuario, vaga: Vaga): boolean
    + verificarVagaAberta(vaga: Vaga): boolean
    + verificarCandidaturaExistente(estudante: Usuario, vaga: Vaga): boolean
    + listarVagasAbertas(): List<Vaga>
    + filtrarVagas(area: Area, modalidade: Modalidade): List<Vaga>
    + consultarIndicadores(): void
}

' Relações entre os objetos
Usuario "1" -- "0..*" Vaga : empresa responsável
Area "1" -- "0..*" Vaga : classifica

Usuario "1" -- "0..*" Candidatura : estudante
Vaga "1" -- "0..*" Candidatura : vaga inscrita

PortalVagas ..> Usuario
PortalVagas ..> Area
PortalVagas ..> Vaga
PortalVagas ..> Candidatura

Usuario --> Perfil
Vaga --> Modalidade
Vaga --> SituacaoVaga

note right of Usuario
  - E-mail único.
  - ESTUDANTE deve possuir curso.
  - EMPRESA deve possuir nome.
  - ADMINISTRADOR gerencia áreas.
  - Senha será incluída na Entrega 2.
end note

note right of Vaga
  - Toda vaga possui uma empresa responsável.
  - Toda vaga pertence a uma área.
  - Apenas empresas editam suas próprias vagas.
  - Carga horária semanal > 0.
  - Vaga encerrada não aceita inscrições.
  - Candidaturas anteriores são preservadas.
end note

note right of Candidatura
  - Toda candidatura pertence a um estudante.
  - Toda candidatura pertence a uma vaga.
  - Apenas estudantes podem se candidatar.
  - Não pode haver duplicidade estudante-vaga.
  - A data da inscrição é obrigatória.
end note

note bottom of Area
  - Nome único.
  - Somente administradores cadastram e editam.
  - Não pode ser excluída enquanto estiver
    associada a uma vaga.
end note

note bottom of PortalVagas
  Consulta pública:
  - Exibir vagas abertas.
  - Filtrar por área e modalidade.

  Indicadores administrativos:
  - Estudantes.
  - Empresas.
  - Vagas abertas.
  - Vagas encerradas.
  - Candidaturas.
end note

@enduml
